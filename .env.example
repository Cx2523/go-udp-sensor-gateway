
# Example configuration for the Go edge gateway.
#
# Setup:
# 1. Copy this file to .env.
# 2. Update the values for your network.
# 3. The .env file is excluded from Git via .gitignore.

# HTTP server port
EDGEGATEWAY_HTTPPORT=8081

# UDP listener port
EDGEGATEWAY_UDPPORT=8080

# Gateway IP address
EDGEGATEWAY_IP=192.168.1.100

# Enable UDP message database recording
EDGEGATEWAY_INGEST_ENABLED=false